{
  "name": "dsh-token-activity",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @snownightt/dsh-token-activity run build && pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r exec rm -rf lib coverage .vitest"
  },
  "dependencies": {
    "@snownightt/dsh-token-activity": "^0.1.1",
    "@snownightt/dsh-ui-token-activity": "^0.1.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./packages/token-activity-bundle/cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
